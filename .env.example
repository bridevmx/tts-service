# Application Port
PORT=3000
NODE_ENV=production

# PocketBase Authentication Server Configuration
POCKETBASE_URL=https://pb.tudominio.com
POCKETBASE_COLLECTION=users

# Piper TTS Engine Configuration
# For single-container deployment (Coolify / Easypanel 1-Click Git): http://127.0.0.1:5000/v1/audio/speech
# For docker-compose deployment: http://piper-engine:5000/v1/audio/speech
PIPER_URL=http://127.0.0.1:5000/v1/audio/speech
DEFAULT_VOICE=es_MX-ald-medium
PIPER_CACHE_DIR=/data
